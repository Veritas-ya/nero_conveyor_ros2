<mujoco model="generic_compact_7dof_robot">
  <!-- Retained as the configuration-compatible fallback robot model. -->
  <!--
    This is an intentionally generic, replaceable 7-DoF arm.  It is not an
    attempt to reproduce proprietary NERO dimensions or dynamics.
  -->
  <asset>
    <material name="robot_base_mat" rgba="0.12 0.14 0.17 1"
              specular="0.35" shininess="0.55" reflectance="0.08"/>
    <material name="robot_link_mat" rgba="0.78 0.81 0.84 1"
              specular="0.40" shininess="0.60" reflectance="0.10"/>
    <material name="robot_joint_mat" rgba="0.12 0.44 0.72 1"
              specular="0.35" shininess="0.45"/>
    <material name="gripper_mat" rgba="0.15 0.17 0.20 1"
              specular="0.30" shininess="0.40"/>
    <material name="finger_pad_mat" rgba="0.06 0.07 0.08 1"
              specular="0.05" shininess="0.10"/>
  </asset>

  <default>
    <default class="arm_joint">
      <joint type="hinge" limited="true" damping="1.8"
             frictionloss="0.06" armature="0.018"
             solreflimit="0.008 1" solimplimit="0.90 0.95 0.001"/>
    </default>
    <default class="arm_link">
      <geom type="capsule" material="robot_link_mat" density="1050"
            friction="0.65 0.01 0.001"
            solref="0.008 1" solimp="0.90 0.95 0.001"/>
    </default>
    <default class="joint_housing">
      <geom type="cylinder" material="robot_joint_mat" density="900"
            friction="0.65 0.01 0.001"/>
    </default>
    <default class="finger_collision">
      <geom type="box" material="finger_pad_mat" density="700"
            friction="1.80 0.02 0.002" condim="6"
            solref="0.004 1" solimp="0.92 0.98 0.001"/>
    </default>
  </default>

  <worldbody>
    <body name="robot_base" pos="0 -0.34 0">
      <geom name="robot_base_foot" type="cylinder" pos="0 0 0.035"
            size="0.105 0.035" material="robot_base_mat"/>
      <geom name="robot_base_column" type="cylinder" pos="0 0 0.090"
            size="0.070 0.055" material="robot_base_mat"/>
      <site name="robot_base_site" type="cylinder" pos="0 0 0.145"
            size="0.010 0.003" rgba="0.15 0.65 1.0 1" group="4"/>

      <body name="link_1" pos="0 0 0.145" gravcomp="0.90">
        <joint name="joint_1" class="arm_joint" axis="0 0 1"
               range="-2.967 2.967"/>
        <geom name="link_1_geom" class="arm_link"
              fromto="0 0 0 0 0 0.120" size="0.044"/>
        <geom name="joint_1_housing" class="joint_housing"
              pos="0 0 0" size="0.057 0.040"/>

        <body name="link_2" pos="0 0 0.120" gravcomp="0.90">
          <joint name="joint_2" class="arm_joint" axis="0 1 0"
                 range="-2.094 2.094"/>
          <geom name="link_2_geom" class="arm_link"
                fromto="0 0 0 0 0 0.200" size="0.040"/>
          <geom name="joint_2_housing" class="joint_housing"
                pos="0 0 0" euler="1.5707963 0 0" size="0.052 0.045"/>

          <body name="link_3" pos="0 0 0.200" gravcomp="0.88">
            <joint name="joint_3" class="arm_joint" axis="1 0 0"
                   range="-2.967 2.967"/>
            <geom name="link_3_geom" class="arm_link"
                  fromto="0 0 0 0 0 0.180" size="0.036"/>
            <geom name="joint_3_housing" class="joint_housing"
                  pos="0 0 0" euler="0 1.5707963 0" size="0.047 0.040"/>

            <body name="link_4" pos="0 0 0.180" gravcomp="0.88">
              <joint name="joint_4" class="arm_joint" axis="0 1 0"
                     range="-2.618 2.618"/>
              <geom name="link_4_geom" class="arm_link"
                    fromto="0 0 0 0 0 0.160" size="0.033"/>
              <geom name="joint_4_housing" class="joint_housing"
                    pos="0 0 0" euler="1.5707963 0 0" size="0.043 0.038"/>

              <body name="link_5" pos="0 0 0.160" gravcomp="0.86">
                <joint name="joint_5" class="arm_joint" axis="1 0 0"
                       range="-2.967 2.967"/>
                <geom name="link_5_geom" class="arm_link"
                      fromto="0 0 0 0 0 0.120" size="0.030"/>
                <geom name="joint_5_housing" class="joint_housing"
                      pos="0 0 0" euler="0 1.5707963 0" size="0.039 0.034"/>

                <body name="link_6" pos="0 0 0.120" gravcomp="0.84">
                  <joint name="joint_6" class="arm_joint" axis="0 1 0"
                         range="-2.269 2.269"/>
                  <geom name="link_6_geom" class="arm_link"
                        fromto="0 0 0 0 0 0.100" size="0.027"/>
                  <geom name="joint_6_housing" class="joint_housing"
                        pos="0 0 0" euler="1.5707963 0 0" size="0.036 0.031"/>

                  <body name="link_7" pos="0 0 0.100" gravcomp="0.82">
                    <joint name="joint_7" class="arm_joint" axis="1 0 0"
                           range="-3.054 3.054"/>
                    <geom name="link_7_geom" class="arm_link"
                          fromto="0 0 0 0 0 0.070" size="0.024"/>
                    <geom name="joint_7_housing" class="joint_housing"
                          pos="0 0 0" euler="0 1.5707963 0" size="0.033 0.028"/>

                    <!-- Local +Z continues away from link_7 and is the approach axis. -->
                    <body name="gripper_base" pos="0 0 0.070" gravcomp="0.75">
                      <geom name="gripper_palm_geom" type="box"
                            pos="0 0 0.012" size="0.042 0.048 0.012"
                            material="gripper_mat" density="800"/>
                      <site name="ee_site" type="sphere" pos="0 0 0.082"
                            size="0.007" rgba="0.95 0.25 0.10 0.85" group="4"/>
                      <site name="grasp_attach_site" type="sphere" pos="0 0 0.058"
                            size="0.004" rgba="1.0 0.85 0.15 0.35" group="4"/>

                      <camera name="wrist_camera" mode="fixed"
                              pos="0.055 0 0.015" quat="0 1 0 0" fovy="58"/>
                      <geom name="wrist_camera_housing" class="visual_only"
                            type="box" pos="0 0 0.021"
                            size="0.015 0.015 0.005" rgba="0.07 0.08 0.10 1"/>

                      <body name="left_finger" pos="0 0.012 0.018">
                        <joint name="finger_left_joint" type="slide"
                               axis="0 1 0" range="0 0.030"
                               limited="true" damping="2.2"
                               frictionloss="0.10" armature="0.002"/>
                        <geom name="left_finger_geom" class="finger_collision"
                              pos="0 0 0.040" size="0.009 0.006 0.034"/>
                        <site name="left_finger_pad_site" type="box"
                              pos="0 -0.0062 0.040" size="0.008 0.0015 0.025"
                              rgba="0.15 0.95 0.25 0.25" group="4"/>
                      </body>

                      <body name="right_finger" pos="0 -0.012 0.018">
                        <joint name="finger_right_joint" type="slide"
                               axis="0 -1 0" range="0 0.030"
                               limited="true" damping="2.2"
                               frictionloss="0.10" armature="0.002"/>
                        <geom name="right_finger_geom" class="finger_collision"
                              pos="0 0 0.040" size="0.009 0.006 0.034"/>
                        <site name="right_finger_pad_site" type="box"
                              pos="0 0.0062 0.040" size="0.008 0.0015 0.025"
                              rgba="0.15 0.95 0.25 0.25" group="4"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="robot_base" body2="link_1"/>
    <exclude body1="link_1" body2="link_2"/>
    <exclude body1="link_2" body2="link_3"/>
    <exclude body1="link_3" body2="link_4"/>
    <exclude body1="link_4" body2="link_5"/>
    <exclude body1="link_5" body2="link_6"/>
    <exclude body1="link_6" body2="link_7"/>
    <exclude body1="link_7" body2="gripper_base"/>
  </contact>

  <tendon>
    <fixed name="gripper_opening_tendon" limited="true" range="0 0.060">
      <joint joint="finger_left_joint" coef="1"/>
      <joint joint="finger_right_joint" coef="1"/>
    </fixed>
  </tendon>

  <equality>
    <joint name="finger_symmetry"
           joint1="finger_right_joint" joint2="finger_left_joint"
           polycoef="0 1 0 0 0"
           solref="0.004 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <position name="joint_1_actuator" joint="joint_1"
              kp="240" ctrlrange="-2.967 2.967" forcerange="-90 90"/>
    <position name="joint_2_actuator" joint="joint_2"
              kp="220" ctrlrange="-2.094 2.094" forcerange="-90 90"/>
    <position name="joint_3_actuator" joint="joint_3"
              kp="180" ctrlrange="-2.967 2.967" forcerange="-65 65"/>
    <position name="joint_4_actuator" joint="joint_4"
              kp="150" ctrlrange="-2.618 2.618" forcerange="-55 55"/>
    <position name="joint_5_actuator" joint="joint_5"
              kp="100" ctrlrange="-2.967 2.967" forcerange="-35 35"/>
    <position name="joint_6_actuator" joint="joint_6"
              kp="70" ctrlrange="-2.269 2.269" forcerange="-25 25"/>
    <position name="joint_7_actuator" joint="joint_7"
              kp="45" ctrlrange="-3.054 3.054" forcerange="-18 18"/>
    <position name="gripper_actuator" tendon="gripper_opening_tendon"
              kp="380" ctrlrange="0 0.060" forcerange="-80 80"/>
  </actuator>

  <sensor>
    <jointpos name="joint_1_pos" joint="joint_1"/>
    <jointpos name="joint_2_pos" joint="joint_2"/>
    <jointpos name="joint_3_pos" joint="joint_3"/>
    <jointpos name="joint_4_pos" joint="joint_4"/>
    <jointpos name="joint_5_pos" joint="joint_5"/>
    <jointpos name="joint_6_pos" joint="joint_6"/>
    <jointpos name="joint_7_pos" joint="joint_7"/>
    <jointvel name="joint_1_vel" joint="joint_1"/>
    <jointvel name="joint_2_vel" joint="joint_2"/>
    <jointvel name="joint_3_vel" joint="joint_3"/>
    <jointvel name="joint_4_vel" joint="joint_4"/>
    <jointvel name="joint_5_vel" joint="joint_5"/>
    <jointvel name="joint_6_vel" joint="joint_6"/>
    <jointvel name="joint_7_vel" joint="joint_7"/>
    <framepos name="ee_position" objtype="site" objname="ee_site"/>
    <framequat name="ee_quaternion" objtype="site" objname="ee_site"/>
    <framelinvel name="ee_linear_velocity" objtype="site" objname="ee_site"/>
    <frameangvel name="ee_angular_velocity" objtype="site" objname="ee_site"/>
    <tendonpos name="gripper_opening" tendon="gripper_opening_tendon"/>
    <touch name="left_finger_touch" site="left_finger_pad_site"/>
    <touch name="right_finger_touch" site="right_finger_pad_site"/>
  </sensor>
</mujoco>
